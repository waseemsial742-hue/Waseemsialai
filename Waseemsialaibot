# =========================
# AI / SIGNAL ENGINE
# =========================

def generate_signal():
    """
    Demo signal engine.

    IMPORTANT:
    This is NOT a real market prediction model.
    Replace this function later with real candle/market-data analysis.
    """

    asset = random.choice(ASSETS)

    direction = random.choice([
        "CALL 🟢",
        "PUT 🔴",
        "NO TRADE ⚪",
    ])

    if direction == "NO TRADE ⚪":
        confidence = random.randint(40, 59)
    else:
        confidence = random.randint(70, 92)

    expiry = random.choice([
        "1 minute",
        "2 minutes",
        "3 minutes",
    ])

    reasons = [
        "EMA trend analysis",
        "RSI momentum",
        "MACD momentum",
        "Bollinger Band analysis",
        "Price action",
    ]

    reason = random.choice(reasons)

    return {
        "asset": asset,
        "direction": direction,
        "confidence": confidence,
        "expiry": expiry,
        "reason": reason,
    }


# =========================
# /START
# =========================

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):

    user = update.effective_user

    message = (
        f"🤖 *{BOT_NAME}*\n\n"
        f"Welcome, {user.first_name}!\n\n"
        "📊 AI Trading Signal Bot\n\n"
        "Available commands:\n"
        "🔹 /signal - Get a trading signal\n"
        "🔹 /help - Show help\n"
        "🔹 /about - About the bot\n\n"
        "⚠️ Signals are for educational/demo purposes. "
        "They are not guaranteed predictions."
    )

    await update.message.reply_text(
        message,
        parse_mode="Markdown"
    )


# =========================
# /SIGNAL
# =========================

async def signal(update: Update, context: ContextTypes.DEFAULT_TYPE):

    await update.message.reply_text(
        "🔎 Analyzing market conditions..."
    )

    data = generate_signal()

    now = datetime.now(timezone.utc).strftime(
        "%Y-%m-%d %H:%M UTC"
    )

    message = (
        f"🤖 *{BOT_NAME}*\n\n"
        f"📊 *NEW SIGNAL*\n\n"
        f"💱 Asset: `{data['asset']}`\n"
        f"📌 Direction: *{data['direction']}*\n"
        f"⏱ Expiry: `{data['expiry']}`\n"
        f"🎯 Confidence: *{data['confidence']}%*\n"
        f"🧠 Analysis: `{data['reason']}`\n"
        f"🕐 Time: `{now}`\n\n"
        "⚠️ *Demo signal only.*\n"
        "Do not risk real money based only on this signal."
    )

    await update.message.reply_text(
        message,
        parse_mode="Markdown"
    )


